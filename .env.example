# Copy to .env.local for local development, or set these in your host (Vercel → Settings → Environment Variables).

# The password visitors must enter. Required in production (the site stays locked without it).
BIRTHDAY_PASSWORD=

# Optional: where visit events are sent. A Discord channel webhook URL works out of the box.
TRACK_WEBHOOK_URL=
# Optional: set to "json" to receive raw JSON events instead of Discord-style messages.
TRACK_WEBHOOK_FORMAT=
# Optional: set to "off" to disable tracking entirely.
TRACKING=
